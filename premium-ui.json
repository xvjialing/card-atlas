{
  "profile": "product-admin",
  "sourceRoots": ["frontend/src"],
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": [
    "Table Selection",
    "Select/Listbox",
    "Date",
    "Form",
    "Scrollbar",
    "Toast"
  ],
  "ownership": {
    "Select/Listbox": "authored",
    "Date": "native"
  },
  "commands": {
    "typecheck": "pnpm typecheck",
    "build": "pnpm build:frontend",
    "test": "go test -race ./...",
    "frontend-test": "pnpm test"
  }
}
